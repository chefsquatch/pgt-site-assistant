# Copy this file to .env and fill in your real key.
# The real .env is gitignored and must NEVER be committed. In production, set
# these in the deploy platform's dashboard (Render: Environment tab).

# Your Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used to generate grounded answers (optional; this is the default).
ANTHROPIC_MODEL=claude-sonnet-4-5

# The founder's inbox — the single handoff target (optional; this is the default).
FOUNDER_EMAIL=lesfleming@precisionguessworktech.com

# Browser origins allowed to call the API (optional; comma-separated). Defaults
# already include the live site and localhost. Add a preview origin here if needed.
# ALLOWED_ORIGINS=https://precisionguessworktech.com,http://localhost:8000

# Max conversation turns sent to the model (optional; default 24).
# MAX_HISTORY_TURNS=24

# --- Engine store (Brick 1+) -----------------------------------------------------
# The tenant-scoped store's connection string (Neon Postgres in prod). Required to
# run `python -m scripts.init_db` and, from Brick 2 on, by the running app.
# Use a POOLED connection string that supports real transactions (node-postgres /
# psycopg), NOT the Neon HTTP driver URL.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# A Neon TEST BRANCH connection string, used only by the wall test
# (tests/test_tenant_wall.py). The test SKIPS when this is unset.
# TEST_DATABASE_URL=postgresql://user:pass@host/db_test?sslmode=require

# OWED at Brick 3 (admin auth): server secret for signing admin session cookies.
# ADMIN_SESSION_SECRET=change-me-in-prod
